{
  "name": "rk-designsystem",
  "version": "1.3.5",
  "description": "A React component library built on top of Digdir Design System",
  "author": "daniel@tunetek.no",
  "license": "MIT",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "typescript",
    "digdir",
    "norwegian"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/norwegianredcross/DesignSystem.git"
  },
  "homepage": "https://norwegianredcross.github.io/DesignSystem/storybook",
  "bugs": {
    "url": "https://github.com/norwegianredcross/DesignSystem/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": false,
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./dist/rk-designsystem.css": "./dist/rk-designsystem.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@digdir/designsystemet-css": "~1.13.3",
    "@digdir/designsystemet-react": "~1.13.3",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run copy-styles && node scripts/embed-color-types.mjs",
    "copy-styles": "node scripts/build-styles.mjs",
    "test:packaging": "node scripts/packaging-smoke.mjs",
    "clean": "rimraf dist",
    "lint": "eslint . --max-warnings=0",
    "check:tokens": "node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "prepack": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "npm run generate-metadata && npm run update-ai-guide-components && npm run generate-ai-context-manifest && storybook build --output-dir storybook-build && node scripts/copy-ai-artifacts.mjs",
    "generate-metadata": "node generate-metadata.mjs",
    "update-ai-guide-components": "node update-ai-guide-components.mjs",
    "generate-ai-context-manifest": "node generate-ai-context-manifest.mjs",
    "predeploy:storybook": "npm run build-storybook",
    "deploy:storybook": "gh-pages -d storybook-build -b gh-pages -r https://github.com/norwegianredcross/DesignSystem.git --dest storybook",
    "build:app": "vite build --config vite.app.config.ts",
    "deploy:app": "npm run build:app && gh-pages -d dist-app -b gh-pages -r https://github.com/norwegianredcross/DesignSystem.git --add",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots"
  },
  "devDependencies": {
    "@digdir/designsystemet": "~1.13.3",
    "@digdir/designsystemet-css": "~1.13.3",
    "@digdir/designsystemet-react": "~1.13.3",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.56.1",
    "@storybook/addon-a11y": "^10.2.12",
    "@storybook/addon-docs": "^10.2.12",
    "@storybook/addon-vitest": "^10.2.12",
    "@storybook/react-vite": "^10.2.12",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "gh-pages": "^6.3.0",
    "glob": "^11.0.3",
    "globals": "^17.11.0",
    "playwright": "^1.52.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "storybook": "^10.2.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@digdir/designsystemet-types": "1.13.3",
    "@navikt/aksel-icons": "^8.16.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "rk-design-tokens": "^1.0.49"
  }
}
